<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4">
    <h1><%= title %></h1>
    <p>Welcome to the Caregiver Dashboard.</p>
    <div class="card p-3 mb-3">
        <h3>Patient: <%= patient.name %></h3>
        <p>Diagnosis: <%= patient.diagnosis %></p>
        <a href="/caregiver/patient/<%= patient.id %>" class="btn btn-primary">View Details</a>
    </div>
    <div class="card p-3">
        <h3>Recent Interactions</h3>
        <ul class="list-group">
            <% interactions.forEach(function(interaction) { %>
                <li class="list-group-item">
                    <strong><%= interaction.date %></strong>: <%= interaction.question %>
                </li>
            <% }); %>
        </ul>
        <a href="/caregiver/interactions" class="btn btn-secondary mt-2">View All</a>
    </div>
</body>
</html>
