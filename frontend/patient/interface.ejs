<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background-image: url('/images/family.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            margin: 0;
            padding: 0;
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .interface-container {
            height: 100vh;
            width: 100vw;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            background: rgba(0, 0, 0, 0.3);
            /* Dark overlay to improve text readability */
        }

        .main-card {
            background: transparent;
            border: none;
            border-radius: 0;
            height: 100vh;
            width: 100vw;
            display: flex;
            flex-direction: column;
        }

        .time-display {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            color: white;
            border-radius: 20px !important;
            padding: 2rem 3rem !important;
            text-align: center;
            margin-bottom: 4rem !important;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.18);
        }

        .time-display h3 {
            font-size: 2.5rem !important;
            margin-bottom: 0.7rem !important;
            font-weight: 500;
        }

        .time-display small {
            font-size: 1.2rem !important;
            opacity: 1;
        }

        .greeting {
            font-size: 2rem !important;
            color: white;
            /* Changed to white for better contrast on photo */
            font-weight: 600;
            text-align: center;
            margin-bottom: 4rem !important;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
        }

        .memo-bubble {
            position: relative;
            z-index: 10;
        }

        .bubble-content {
            margin-bottom: 4rem !important;
            width: 260px !important;
            height: 260px !important;
            animation: wiggle 3s infinite ease-in-out;

            /* Glassmorphism Style */
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.2);

            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .bubble-content::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(45deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0));
            border-radius: 50%;
            animation: rotate 20s linear infinite;
        }

        .memo-logo {
            position: relative;
            z-index: 2;
            text-align: center;
        }

        .logo-image {
            width: 160px !important;
            height: 160px !important;
            object-fit: contain;
            /* Brightness adjusted for glass background */
            filter: brightness(1) drop-shadow(0 4px 6px rgba(0, 0, 0, 0.1));
        }

        .reminder {
            background: rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            color: white;
            border-radius: 20px !important;
            padding: 1.5rem 2.5rem !important;
            text-align: center;
            margin-top: 4rem !important;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
            border: 1px solid rgba(255, 255, 255, 0.18);
            font-size: 1.7rem !important;
            font-weight: 700;
        }

        .reminder i {
            margin-right: 0.5rem;
        }

        /* Animations */
        @keyframes rotate {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        @keyframes wiggle {

            0%,
            100% {
                transform: scale(1) rotate(0deg);
            }

            25% {
                transform: scale(1.1) rotate(-3deg);
            }

            50% {
                transform: scale(1.15) rotate(0deg);
            }

            75% {
                transform: scale(1.1) rotate(3deg);
            }
        }

        @keyframes bounce {

            0%,
            100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-5px);
            }
        }

        .bubble-content.interacting .logo-image {
            animation: bounce 0.6s ease-in-out;
        }

        /* Media queries pour iPad */
        /* Media queries pour iPad Air 4 (Landscape: 1180px x 820px) */
        @media screen and (min-width: 1024px) and (max-width: 1366px) and (orientation: landscape) {
            .interface-container {
                padding: 0 2rem;
            }

            .main-card {
                /* Ensure card creates context for absolute positioning if needed, but mainly fit height */
                justify-content: space-evenly !important;
            }

            .card-body {
                /* Override bootstrap justify-content-center to use space-evenly for better vertical distribution */
                justify-content: space-evenly !important;
                padding: 1rem !important;
            }

            .bubble-content {
                /* Use vh to scale with screen height, max 250px */
                width: 28vh !important;
                height: 28vh !important;
                max-width: 250px !important;
                max-height: 250px !important;
                margin-bottom: 1rem !important;
                margin-top: 1rem !important;
            }

            .logo-image {
                width: 60% !important;
                height: 60% !important;
            }

            .time-display {
                padding: 1rem 2rem !important;
                margin-bottom: 1rem !important;
            }

            .time-display h3 {
                font-size: 2.5rem !important;
                margin-bottom: 0 !important;
            }

            .time-display small {
                font-size: 1.2rem !important;
            }

            .greeting {
                font-size: 2rem !important;
                margin-bottom: 1rem !important;
                margin-top: 0 !important;
            }

            .reminder {
                padding: 1rem 2rem !important;
                margin-top: 1rem !important;
                font-size: 1.4rem !important;
            }
        }

        /* Garder le support pour les très grands écrans si nécessaire, ou l'adapter */
        @media screen and (min-width: 2000px) {
            .bubble-content {
                width: 400px !important;
                height: 400px !important;
            }

            /* ... autres styles grands écrans conservés ... */
        }
    </style>
</head>

<body>
    <div class="interface-container">
        <div class="main-card">
            <div class="card-body d-flex flex-column justify-content-center align-items-center h-100 position-relative">

                <!-- Standby Button -->
                <div class="position-absolute top-0 end-0 m-4 d-flex gap-2" style="z-index: 1000;">
                    <a href="/patient/game"
                        class="btn btn-outline-light rounded-circle d-flex align-items-center justify-content-center text-decoration-none"
                        style="width: 50px; height: 50px; background: rgba(255,255,255,0.2); border: none;">
                        <i class="bi bi-controller" style="font-size: 1.2rem;"></i>
                    </a>
                    <a href="/patient/standby"
                        class="btn btn-outline-light rounded-circle d-flex align-items-center justify-content-center text-decoration-none"
                        style="width: 50px; height: 50px; background: rgba(255,255,255,0.2); border: none;">
                        <i class="bi bi-moon-stars-fill" style="font-size: 1.2rem;"></i>
                    </a>
                </div>

                <!-- Affichage de l'heure -->
                <div class="time-display">
                    <h3 id="currentTime">2:30 PM</h3>
                    <small id="currentDate">Tuesday, January 7, 2026</small>
                </div>

                <!-- Message de salutation -->
                <div class="greeting">
                    Hello John
                </div>

                <!-- Bulle centrale avec logo MEMO -->
                <div class="memo-bubble">
                    <div class="bubble-content">
                        <div class="memo-logo">
                            <img src="/images/Gemini_Generated_Image_t2n2x1t2n2x1t2n2-removebg-preview.png"
                                alt="MEMO Logo" class="logo-image">
                        </div>
                    </div>
                </div>

                <!-- Rappel -->
                <div class="reminder">
                    <i class="bi bi-calendar-event"></i>
                    Meet up with Sarah at 2:00 PM
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Automatic time update
        function updateTime() {
            const now = new Date();
            const timeString = now.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                hour12: true
            });
            const dateString = now.toLocaleDateString('en-US', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });

            document.getElementById('currentTime').textContent = timeString;
            document.getElementById('currentDate').textContent = dateString;
        }

        // Update time every minute
        setInterval(updateTime, 60000);

        // Update time on load
        document.addEventListener('DOMContentLoaded', function () {
            updateTime();

            const bubble = document.querySelector('.bubble-content');
            const logoImage = document.querySelector('.logo-image');
            
            // Speech Recognition Setup
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                console.error("Browser does not support Speech Recognition");
                // TODO: Show fallback UI
            }

            const recognition = new SpeechRecognition();
            recognition.continuous = false;
            recognition.lang = 'en-US';
            recognition.interimResults = false;
            recognition.maxAlternatives = 1;

            let isListening = false;

            recognition.onstart = function() {
                isListening = true;
                bubble.style.background = 'rgba(255, 100, 100, 0.3)'; // Redish pulse
                bubble.style.animation = 'wiggle 0.5s infinite ease-in-out'; // Faster wiggle
            };

            // Optimization: Stop immediately when speech ends (don't wait for silence timeout)
            recognition.onspeechend = function() {
                console.log('Speech ended, stopping recognition...');
                recognition.stop();
                // Visual feedback that we are processing
                bubble.style.background = 'rgba(100, 100, 255, 0.3)'; 
            };

            recognition.onend = function() {
                isListening = false;
                bubble.style.background = 'rgba(255, 255, 255, 0.15)'; // Reset
                bubble.style.animation = 'wiggle 3s infinite ease-in-out';
            };

            recognition.onresult = function(event) {
                const transcript = event.results[0][0].transcript;
                console.log('User said:', transcript);
                
                // Send to backend
                sendToAI(transcript);
            };

            // Speech Synthesis Setup
            const synth = window.speechSynthesis;

            function speak(text) {
                if (synth.speaking) {
                    console.error('speechSynthesis.speaking');
                    return;
                }
                
                if (text !== '') {
                    const utterThis = new SpeechSynthesisUtterance(text);
                    utterThis.onend = function (event) {
                        console.log('SpeechSynthesisUtterance.onend');
                        bubble.classList.remove('interacting');
                    }
                    utterThis.onerror = function (event) {
                        console.error('SpeechSynthesisUtterance.onerror');
                    }
                    
                    // Optional: Choose a voice
                    // const voices = synth.getVoices();
                    // utterThis.voice = voices[0]; 

                    bubble.classList.add('interacting'); // Bounce animation
                    synth.speak(utterThis);
                }
            }

            async function sendToAI(text) {
                // Determine interaction type
                let interactionType = 'chat';
                if(text.toLowerCase().includes('time')) interactionType = 'temporal';
                if(text.toLowerCase().includes('where')) interactionType = 'spatial';

                try {
                   const response = await fetch('/patient/ai-response', {
                       method: 'POST',
                       headers: {
                           'Content-Type': 'application/json'
                       },
                       body: JSON.stringify({ 
                           question: text,
                           type: interactionType
                       })
                   });
                   
                   const data = await response.json();
                   if(data.success) {
                       console.log('AI Response:', data.response);
                       speak(data.response);
                   } else {
                       console.error('AI Error:', data.error);
                       speak("I'm sorry, I'm having trouble connecting to my brain right now.");
                   }

                } catch (error) {
                    console.error('Network Error:', error);
                    speak("I'm sorry, I seem to have lost connection.");
                }
            }

            // AUDIO FILE MANAGEMENT
            // We pre-load audio objects to ensure they are ready to play on touch
            const audioFiles = [
                new Audio('/audio/step0.mp3'),
                new Audio('/audio/step1.mp3'),
                new Audio('/audio/step2.mp3')
            ];

            function tryPlayAudio(index, textFallback) {
                const audio = audioFiles[index];
                if (audio) {
                    console.log('Attempting to play audio file:', audio.src);
                    const playPromise = audio.play();
                    
                    if (playPromise !== undefined) {
                        playPromise
                        .then(_ => {
                            // Audio playback started!
                            console.log('Audio playing successfully');
                            bubble.classList.add('interacting');
                            audio.onended = () => bubble.classList.remove('interacting');
                        })
                        .catch(error => {
                            // Auto-play was prevented or file no exists
                            console.warn('Audio play failed, falling back to TTS:', error);
                            speak(textFallback);
                        });
                    }
                } else {
                    speak(textFallback);
                }
            }

            // WIZARD OF OZ MODE: Simulated Interaction Script
            let scriptIndex = 0;
            const demoScript = [
                { 
                    trigger: "Hello, who are you?", 
                    response: "Hello! I am MEMO, your assistant. How can I help you today?" 
                },
                { 
                    trigger: "Where am I?", 
                    response: "You are at your house, You are the Barista of the house. Why don't we make a coffee?" 
                },
                { 
                    trigger: "Yes, let's make coffee", 
                    response: "Take the blue jar. Smell the beans." 
                }
            ];

            // Interaction Event
            bubble.addEventListener('click', function () {
                if (!isListening) {
                    // START LISTENING STATE (Visual only)
                    isListening = true;
                    bubble.style.background = 'rgba(255, 100, 100, 0.3)'; // Redish pulse
                    bubble.style.animation = 'wiggle 0.5s infinite ease-in-out'; // Faster wiggle
                    
                    // iOS Hack 1: Prime the speech synthesis engine
                    window.speechSynthesis.cancel();
                    window.speechSynthesis.speak(new SpeechSynthesisUtterance(' '));

                    // iOS Hack 2: Bless all audio files for future playback
                    // We play them for 0s and pause immediately to unlock them
                    audioFiles.forEach(audio => {
                        audio.volume = 0;
                        audio.play().then(() => {
                            audio.pause();
                            audio.currentTime = 0;
                            audio.volume = 1; // Restore volume for later
                        }).catch(e => console.log('Audio bless failed (harmless if not user interaction)', e));
                    });

                } else {
                    // STOP LISTENING STATE -> SIMULATE PROCESSING (DELAY)
                    isListening = false;
                    
                    // Visual Transition: "Thinking" state (Blue pulse)
                    bubble.style.background = 'rgba(100, 100, 255, 0.3)'; 
                    bubble.style.animation = 'wiggle 1s infinite ease-in-out';

                    // Pick phrase from script
                    const step = demoScript[scriptIndex % demoScript.length];
                    console.log('Simulating User Speech:', step.trigger);
                    scriptIndex++; // Increment for next time

                    // 1.5s Delay to simulate "Thinking"
                    setTimeout(() => {
                         // Reset Bubble
                        bubble.style.background = 'rgba(255, 255, 255, 0.15)'; 
                        bubble.style.animation = 'wiggle 3s infinite ease-in-out';
                        
                        // Trigger Audio (Should work because we blessed it)
                        tryPlayAudio((scriptIndex - 1) % demoScript.length, step.response);
                    }, 1500);
                    
                    // Log to backend
                    fetch('/patient/ai-response', {
                       method: 'POST',
                       headers: { 'Content-Type': 'application/json' },
                       body: JSON.stringify({ question: step.trigger, type: 'chat' })
                   }).catch(e => console.error("Backend log error", e));
                }
            });

            // Entry animation
            const card = document.querySelector('.main-card');
            card.style.opacity = '0';

            setTimeout(() => {
                card.style.transition = 'opacity 0.8s ease-out';
                card.style.opacity = '1';
            }, 100);

            // Demo Loop Logic
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('demo') === 'true') {
                console.log('Demo mode active: Switching to Game in 5s');

                setTimeout(() => {
                    document.body.style.transition = 'opacity 0.8s ease-in-out';
                    document.body.style.opacity = '0';
                }, 4200);

                setTimeout(() => {
                    window.location.href = '/patient/game?demo=true';
                }, 5000);
            }
        });
    </script>
</body>

</html>